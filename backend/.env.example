# Copy to backend/.env and adjust. Use single quotes for values that contain $ or other shell characters.
# These are placeholders for local development only; never commit a real .env.
DB_NAME=sca
DB_USER=root
DB_PASSWORD=change-me
JWT_SECRET_KEY=replace-with-a-long-random-string
PORT=3000

# Optional: creates the first administrator (level 2) on startup if that user does not exist yet.
# Leave both empty to create no account. Choose your own values; there is no default.
# SEED_ADMIN_USER=1000
# SEED_ADMIN_PASSWORD='choose-a-strong-password'
